# AMAPI / enterprise
ENTERPRISE_ID=enterprises/your-enterprise-id
OLD_ENTERPRISE_ID=enterprises/your-old-enterprise-id
PROJECT_ID=your-gcp-project-id
POLICY_NAME=your-policy-name
SIGNUP_URL_NAME=signupUrls/your-signup-url-id
ENTERPRISE_TOKEN=your-enterprise-token
KEY_FILE=./service_accounts/service-account.json

# Enrollment
ENROLLMENT_TOKEN_DURATION=604800s
ENROLLMENT_ADDITIONAL_DATA=your-device-label

# Firebase / FCM
# Resolved relative to services/ (passed to require())
FIREBASE_KEY_FILE=../service_accounts/firebase-service-account.json
FCM_TOPIC=your-fcm-topic

# Provisioning
DEVICE_ADMIN_COMPONENT=com.example.app/.receivers.YourDeviceAdminReceiver
EXPECTED_CHECKSUM=your-apk-signature-checksum
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password
WIFI_SECURITY_TYPE=WPA

# Ports
SERVER_PORT=3000
UPDATE_SERVER_PORT=4000
APK_SERVE_PORT=8080

# Paths
DATA_DIR=./data
APKSIGNER_PATH=/path/to/android/sdk/build-tools/<version>/apksigner
AAPT_PATH=/path/to/android/sdk/build-tools/<version>/aapt
APK_SERVE_DIR=/path/to/apk/serve/dir
SERVE_APK_PATH=/path/to/app-release.apk
DEPLOY_APK_PATH=/path/to/project/app/build/outputs/apk/release/app-release.apk
